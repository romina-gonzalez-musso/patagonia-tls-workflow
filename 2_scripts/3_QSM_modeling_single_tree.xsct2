										<Version value="1"></Version>
										<DoubleValue value="0.01" id="52" description="The radius of the search sphere during sphereFollowing is never smaller than [&#60;em&#62;&#60;b&#62;min global radius&#60;&#47;b&#62;&#60;&#47;em&#62;] "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
