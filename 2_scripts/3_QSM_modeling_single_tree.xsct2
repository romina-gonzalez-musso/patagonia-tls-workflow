		<Step plugin="plug_simpleforest" type="SF_StepSpherefollowingBasic" debug="off" id="12">
			<S1>
				<Settings>
					<CT_VirtualAbstractStep>
						<PreConfigDialog>
							<Version>
								<V value="1" id="25" description=""></V>
							</Version>
							<Widget>
								<CT_CheckBox>
									<Values>
										<Version value="1"></Version>
										<Checked value="true" id="26" description="Uncheck to deactivate parameterization possibilities of this step. Only recommended for beginners"></Checked>
										<Text value="expert" id="27" description=""></Text>
									</Values>
								</CT_CheckBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="medium" id="28" description="In beginner mode select point cloud quality"></CurrentTextIndex>
										<ValueList value="low	medium	high	low	medium	high" id="29" description="In beginner mode select point cloud quality"></ValueList>
									</Values>
								</CT_ComboBox>
							</Widget>
						</PreConfigDialog>
						<PostConfigDialog>
							<Version>
								<V value="1" id="30" description=""></V>
							</Version>
							<Widget>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.02" id="31" description="To even out the distribution and speed things up the cloud is downscaled first to [&#60;em&#62;&#60;b&#62;voxel size&#60;&#47;b&#62;&#60;&#47;em&#62;] "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.1" id="32" description="Only the largest cluster will be processed with [&#60;em&#62;&#60;b&#62;clustering range&#60;&#47;b&#62;&#60;&#47;em&#62;]  "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_CheckBox>
									<Values>
										<Version value="1"></Version>
										<Checked value="true" id="33" description="You can let Simple Forest choose the following method parameters"></Checked>
										<Text value="" id="34" description=""></Text>
									</Values>
								</CT_CheckBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="2" id="35" description="To generate a sphere each fitted circle is multiplied with the [&#60;em&#62;&#60;b&#62;sphere multiplier&#60;&#47;b&#62;&#60;&#47;em&#62;]"></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="75&#38;#37;; 100&#38;#37;; 150&#38;#37;" id="36" description="We search for &#60;em&#62;sphere multiplier&#60;&#47;em&#62; with the following potential parameterization:"></CurrentTextIndex>
										<ValueList value="100&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;; 200&#38;#37;; 250&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 250&#38;#37;; 300&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 180&#38;#37;; 240&#38;#37;; 300&#38;#37;; 370; 450	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 240&#38;#37;; 300&#38;#37;; 400&#38;#37;; 500&#38;#37;; 600&#38;#37;; 700&#38;#37;" id="37" description="We search for &#60;em&#62;sphere multiplier&#60;&#47;em&#62; with the following potential parameterization:"></ValueList>
									</Values>
								</CT_ComboBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.01" id="38" description="The sphere surface has a thickness of [&#60;em&#62;&#60;b&#62;sphere epsilon&#60;&#47;b&#62;&#60;&#47;em&#62;] "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="75&#38;#37;; 100&#38;#37;; 150&#38;#37;" id="39" description="We search for &#60;em&#62;sphere epsilon&#60;&#47;em&#62; with the following potential parameterization:"></CurrentTextIndex>
										<ValueList value="100&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;; 200&#38;#37;; 250&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 250&#38;#37;; 300&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 180&#38;#37;; 240&#38;#37;; 300&#38;#37;; 370; 450	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 240&#38;#37;; 300&#38;#37;; 400&#38;#37;; 500&#38;#37;; 600&#38;#37;; 700&#38;#37;" id="40" description="We search for &#60;em&#62;sphere epsilon&#60;&#47;em&#62; with the following potential parameterization:"></ValueList>
									</Values>
								</CT_ComboBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.03" id="41" description="Point on sphere surface are clustered with threshold  [&#60;em&#62;&#60;b&#62;euclidean clustering distance&#60;&#47;b&#62;&#60;&#47;em&#62;]  "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="75&#38;#37;; 100&#38;#37;; 150&#38;#37;" id="42" description="We search for &#60;em&#62;euclidean clustering distance&#60;&#47;em&#62; with the following potential parameterization:"></CurrentTextIndex>
										<ValueList value="100&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;	75&#38;#37;; 100&#38;#37;; 150&#38;#37;; 200&#38;#37;; 250&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 250&#38;#37;; 300&#38;#37;	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 180&#38;#37;; 240&#38;#37;; 300&#38;#37;; 370; 450	75&#38;#37;; 90&#38;#37;; 100&#38;#37;; 140&#38;#37;; 190&#38;#37;; 240&#38;#37;; 300&#38;#37;; 400&#38;#37;; 500&#38;#37;; 600&#38;#37;; 700&#38;#37;" id="43" description="We search for &#60;em&#62;euclidean clustering distance&#60;&#47;em&#62; with the following potential parameterization:"></ValueList>
									</Values>
								</CT_ComboBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="SECONDMOMENTUMORDERMSAC - minimize cropped &#40;MSAC&#41; root squared distance" id="44" description="For the cloud to model distance we choose [&#60;em&#62;&#60;b&#62;distance method&#60;&#47;b&#62;&#60;&#47;em&#62;] "></CurrentTextIndex>
										<ValueList value="ZEROMOMENTUMORDER       - maximize inliers of model	FIRSTMOMENTUMORDERMSAC  - minimize cropped &#40;MSAC&#41; average absolute distance	FIRSTMOMENTUMORDER      - minimize average absolute distance	SECONDMOMENTUMORDERMSAC - minimize cropped &#40;MSAC&#41; root squared distance	SECONDMOMENTUMORDER     - minimize average root squared distance" id="45" description="For the cloud to model distance we choose [&#60;em&#62;&#60;b&#62;distance method&#60;&#47;b&#62;&#60;&#47;em&#62;] "></ValueList>
									</Values>
								</CT_ComboBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.03" id="46" description="For MSAC and inlier methods the distance is cropped at [&#60;em&#62;&#60;b&#62;crop distance&#60;&#47;b&#62;&#60;&#47;em&#62;] "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_ComboBox>
									<Values>
										<Version value="1"></Version>
										<CurrentTextIndex value="MLESAC  - Maximum LikeLihood Estimation SAmple Consensus" id="47" description="[&#60;em&#62;&#60;b&#62;SAC Model Consensus method&#60;&#47;b&#62;&#60;&#47;em&#62;] "></CurrentTextIndex>
										<ValueList value="Center of Mass with median distance radius	Gauss Newton Least squares	RANSAC  - RANdom SAmple Consensus	LMEDS   - Least Median of Squares	MSAC    - M-Estimator SAmple Consensus	RRANSAC - Randomized RANSAC	RMSAC   - Randomized MSAC	MLESAC  - Maximum LikeLihood Estimation SAmple Consensus	PROSAC  - PROgressive SAmple Consensus" id="48" description="[&#60;em&#62;&#60;b&#62;SAC Model Consensus method&#60;&#47;b&#62;&#60;&#47;em&#62;] "></ValueList>
									</Values>
								</CT_ComboBox>
								<CT_DoubleSpinBox>
									<Values>
										<Version value="1"></Version>
										<DoubleValue value="0.03" id="49" description="The [&#60;em&#62;&#60;b&#62;inlier distance&#60;&#47;b&#62;&#60;&#47;em&#62;] for the selected &#60;em&#62;SAC Model Consensus method&#60;&#47;em&#62; is "></DoubleValue>
									</Values>
								</CT_DoubleSpinBox>
								<CT_SpinBox>
									<Values>
										<Version value="1"></Version>
										<IntValue value="5" id="50" description="For fitting a geometry with the selected &#60;em&#62;SAC Model Consensus method&#60;&#47;em&#62; at minimum [&#60;em&#62;&#60;b&#62;minPts&#60;&#47;b&#62;&#60;&#47;em&#62;]"></IntValue>
									</Values>
								</CT_SpinBox>
								<CT_SpinBox>
									<Values>
										<Version value="1"></Version>
										<IntValue value="100" id="51" description="For the selected &#60;em&#62;SAC Model Consensus method&#60;&#47;em&#62; [&#60;em&#62;&#60;b&#62;iterations&#60;&#47;b&#62;&#60;&#47;em&#62;]"></IntValue>
									</Values>
								</CT_SpinBox>
								<CT_DoubleSpinBox>
